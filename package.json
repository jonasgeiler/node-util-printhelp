{
	"name": "node-util-printhelp",
	"version": "0.0.4",
	"description": "Utility to generate and print CLI help text from a Node.js `util.parseArgs` configuration, designed minimally to resemble a potential future Node.js built-in.",
	"homepage": "https://github.com/jonasgeiler/node-util-printhelp#readme",
	"bugs": "https://github.com/jonasgeiler/node-util-printhelp/issues",
	"license": "MIT",
	"author": "Jonas Geiler <npm@jonasgeiler.com> (https://jonasgeiler.com)",
	"funding": "https://github.com/sponsors/jonasgeiler",
	"repository": "github:jonasgeiler/node-util-printhelp",
	"devEngines": {
		"runtime": {
			"name": "node",
			"version": "26.12.0",
			"onFail": "download"
		},
		"packageManager": {
			"name": "pnpm",
			"version": "12.4.2",
			"onFail": "download"
		}
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.15",
		"@types/node": "26.6.5",
		"typescript": "6.0.3"
	},
	"scripts": {
		"prepare": "git config core.hooksPath .githooks",
		"dev": "pnpm run build --watch",
		"check": "pnpm run '/^check:.*/'",
		"check:biome": "biome check",
		"check:test": "node --test --experimental-test-coverage test/**/*.test.ts",
		"check:tsc": "tsc",
		"fix": "biome check --fix",
		"unsafe-fix": "biome check --unsafe --fix",
		"prebuild": "node --eval='require(`fs`).rmSync(`dist`,{recursive:true,force:true})'",
		"build": "tsc --project tsconfig.build.json",
		"version": "node --eval='const f=`jsr.json`,v=process.env.npm_package_version,s=require(`fs`);s.writeFileSync(f,JSON.stringify({...JSON.parse(s.readFileSync(f,`utf8`)),version:v},null,`\t`)+`\\n`);console.log(`Updated ${f} for v${v}`)' && git add jsr.json",
		"prepack": "pnpm run build"
	},
	"engines": {
		"node": "^22.13.0 || >=23.5.0"
	},
	"type": "module",
	"sideEffects": false,
	"files": [
		"src",
		"dist"
	],
	"exports": {
		".": {
			"types": "./dist/printhelp.d.ts",
			"default": "./dist/printhelp.js"
		},
		"./package.json": "./package.json"
	},
	"keywords": [
		"util.parseArgs",
		"arguments",
		"cli",
		"generator",
		"help",
		"node",
		"node-util",
		"node:util",
		"options",
		"parse",
		"parseArgs",
		"print",
		"printer",
		"util",
		"utilities",
		"utils"
	]
}

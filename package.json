{
	"name": "node-util-printhelp",
	"version": "0.0.2",
	"description": "Utility to generate and print CLI help text from a Node.js `util.parseArgs` configuration, designed minimally to resemble a potential future Node.js built-in.",
	"homepage": "https://github.com/jonasgeiler/node-util-printhelp#readme",
	"bugs": "https://github.com/jonasgeiler/node-util-printhelp/issues",
	"license": "MIT",
	"author": "Jonas Geiler <npm@jonasgeiler.com> (https://jonasgeiler.com)",
	"funding": "https://github.com/sponsors/jonasgeiler",
	"repository": "github:jonasgeiler/node-util-printhelp",
	"scripts": {
		"prepare": "git config core.hooksPath .githooks",
		"dev": "pnpm run build --watch",
		"check": "biome check",
		"fix": "biome check --fix",
		"unsafe-fix": "biome check --unsafe --fix",
		"prebuild": "node --eval='require(`fs`).rmSync(`dist`,{recursive:true,force:true})'",
		"build": "tsc",
		"prepack": "pnpm run build"
	},
	"engines": {
		"node": "^20.16.0 || ^22.4.0"
	},
	"packageManager": "pnpm@12.4.2+sha512.08adc6613180275c7c9edada39dcf08c9c61ad4e7eaf330a4f3461f102b0f907423454d117f98e72d47fef0616070644d7bffc973a6a57f5090a6d7c368b07c9",
	"devDependencies": {
		"@biomejs/biome": "2.5.15",
		"@types/node": "22.20.3",
		"typescript": "^6.0.3"
	},
	"type": "module",
	"files": [
		"src",
		"dist"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./package.json": "./package.json"
	},
	"keywords": [
		"util.parseArgs",
		"arguments",
		"cli",
		"generator",
		"help",
		"node",
		"node-util",
		"node:util",
		"options",
		"parse",
		"parseArgs",
		"print",
		"printer",
		"util",
		"utilities",
		"utils"
	]
}

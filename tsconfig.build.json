/********************************************/
/*              TSConfig file               */
/* https://www.typescriptlang.org/tsconfig/ */
/********************************************/

{
	"$schema": "https://json.schemastore.org/tsconfig",
	"extends": "./tsconfig.json",
	"include": [
		"./src"
	],
	"compilerOptions": {
		// File Layout
		"rootDir": "./src",
		"outDir": "./dist",

		// Other Outputs
		"noEmit": false,
		"sourceMap": true,
		"declaration": true,
		"declarationMap": true,
		"listEmittedFiles": true
	}
}
